# The gateways' settings: copy to .env (git-ignored), fill in what you have.
# `docker compose run --rm omnireview gateways` says what is installed and configured;
# `bare --live` asks, for real, each platform whose key and place are set.

# Where the gateways' checkouts are, when this core sits in the workspace
# beside them (../.. from this directory); unset, they come from GitHub.
#OMNIREVIEW_PLUGINS=../..

# omnireview/google: a Places API (New) key and a place ID (ChIJ...); for the
# owner's side, an OAuth client, a refresh token (scope business.manage) and
# the location (accounts/<id>/locations/<id>).
GOOGLE_PLACES_KEY=
GOOGLE_PLACE_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_LOCATION=

# omnireview/tripadvisor: a Content API key and a location ID.
TRIPADVISOR_KEY=
TRIPADVISOR_LOCATION=
TRIPADVISOR_REFERER=

# omnireview/trustpilot: an API key and a business unit ID; replying and
# inviting take the secret and a business user.
TRUSTPILOT_API_KEY=
TRUSTPILOT_BUSINESS_UNIT=
TRUSTPILOT_API_SECRET=
TRUSTPILOT_BUSINESS_USER_ID=
